# Application
NODE_ENV=development
APP_URL=http://localhost:3000
AUTH_MODE=development
# Client-visible mirror of AUTH_MODE. Next.js only inlines NEXT_PUBLIC_*
# vars when referenced literally in client code, so this must be kept in
# sync with AUTH_MODE by hand.
NEXT_PUBLIC_AUTH_MODE=development
DEVELOPMENT_USER_ID=00000000-0000-4000-8000-000000000001
# Opt-in only; default false. When true AND AUTH_MODE=development, an
# X-Vinylhound-Bench-User-Id request header overrides DEVELOPMENT_USER_ID, so
# a local load-test script can drive traffic as many distinct synthetic
# users. Never consulted when AUTH_MODE=production. See
# scripts/benchmark/README.md.
DEVELOPMENT_BENCH_USER_HEADER_ENABLED=false

# Clerk (required only when AUTH_MODE=production; leave empty for local dev/CI)
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=

# PostgreSQL
DATABASE_URL=postgresql://vinylhound:vinylhound@localhost:5432/vinylhound
DATABASE_MAX_CONNECTIONS=5
DATABASE_CONNECT_TIMEOUT_MS=30000
DATABASE_SSL_MODE=disable
# Base64-encoded PEM CA bundle; required when DATABASE_SSL_MODE=verify-full.
DATABASE_SSL_CA_BASE64=

# Background jobs
# Local development uses BullMQ. AWS deployment workflows set this to sqs and
# inject the queue URLs created by Terraform.
QUEUE_DRIVER=bullmq
REDIS_URL=redis://localhost:6379
SQS_QUEUE_URL=
SQS_DEAD_LETTER_QUEUE_URL=
# P4.2 Task 3: the two confirmation-pipeline queue hops, only required when
# QUEUE_DRIVER=sqs.
SQS_CONFIRMATION_PROCESSING_QUEUE_URL=
SQS_CONFIRMATION_PROCESSING_DEAD_LETTER_QUEUE_URL=
SQS_CONFIRMATION_COMPLETION_QUEUE_URL=
SQS_CONFIRMATION_COMPLETION_DEAD_LETTER_QUEUE_URL=
SQS_MAX_RECEIVE_COUNT=5
SQS_VISIBILITY_TIMEOUT_SECONDS=180
SCAN_QUEUE_NAME=vinylhound-scans
CONFIRMATION_PROCESSING_QUEUE_NAME=vinylhound-confirmation-processing
CONFIRMATION_COMPLETION_QUEUE_NAME=vinylhound-confirmation-completions
OUTBOX_POLL_INTERVAL_MS=1000
# Worker-only: the confirmation pipeline's own hop 1->2/hop 2->3 dispatch
# loops (P4.2 Task 5) -- faster than OUTBOX_POLL_INTERVAL_MS, which now
# governs scan-analysis dispatch only.
CONFIRMATION_DISPATCH_POLL_INTERVAL_MS=200
ANALYSIS_CONCURRENCY=1

# Worker-only: a scan left awaiting_upload with no activity for this long is
# canceled and its orphaned image objects best-effort deleted from storage.
ABANDONED_UPLOAD_TTL_HOURS=24
ABANDONED_UPLOAD_CLEANUP_INTERVAL_MS=1800000
ABANDONED_UPLOAD_CLEANUP_BATCH_SIZE=50

# Worker-only: a confirmation left pending this long is safely re-driven by
# the background reconciliation sweep (P4.2 Task 4).
CONFIRMATION_RECONCILIATION_POLL_INTERVAL_MS=60000
CONFIRMATION_RECONCILIATION_STALE_AFTER_MS=300000
CONFIRMATION_RECONCILIATION_BATCH_SIZE=50

# Worker-only: an account whose deletion was requested but had a pending
# scan_confirmations row at request time is finalized once nothing is left
# pending, by this sweep (P4.2 Task 6).
ACCOUNT_DELETION_POLL_INTERVAL_MS=60000
ACCOUNT_DELETION_BATCH_SIZE=50

CLOUDWATCH_METRICS_ENABLED=false
CLOUDWATCH_METRIC_NAMESPACE=VinylHound
CLOUDWATCH_METRICS_INTERVAL_MS=60000
ENVIRONMENT_NAME=development

# Public-operation abuse and spend controls. Enforced before scan jobs are
# queued; set production values to match the OpenAI project budget. This
# generous local default is NOT what deployed environments run: every
# deployment workflow (development/staging/production) overrides
# USER_MONTHLY_SPEND_LIMIT_USD to 5 (see docs/OPERATIONS.md's "Reconciled
# monthly budget"). This 20 only applies to a local `npm run dev` session run
# with a real OPENAI_API_KEY and no override, which should stay a deliberate,
# rare choice.
USER_DAILY_ANALYSIS_LIMIT=100
USER_ACTIVE_SCAN_LIMIT=20
USER_MONTHLY_SPEND_LIMIT_USD=20
SCAN_COST_RESERVATION_USD=0.25

# S3-compatible object storage (local MinIO defaults)
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=vinylhound-dev
S3_ACCESS_KEY_ID=vinylhound
S3_SECRET_ACCESS_KEY=change-me-for-any-shared-environment
S3_FORCE_PATH_STYLE=true

# Build/deployment provenance shown in structured runtime logs.
DEPLOYMENT_VERSION=development

# OpenAI (server/worker only; never expose this to the browser)
OPENAI_API_KEY=
OPENAI_VISION_MODEL=gpt-5.6-sol
OPENAI_IMAGE_DETAIL=high
OPENAI_TIMEOUT_MS=120000

# Spotify discovery (server-side only; never expose these to the browser).
# Leave empty to disable /discover — the rest of the app, including scanning
# and MusicBrainz pressing lookup, is unaffected. Create an app at
# https://developer.spotify.com/dashboard to get client credentials.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Internal discovery service (staging/production only; ADR-0025, P4.1 Task 2).
# Leave both empty for local development and CI: apps/web then constructs the
# MusicBrainz/Spotify adapters in process, exactly as before this ADR. Setting
# both routes apps/web's catalog and discovery reads through the standalone
# apps/discovery service instead; the shared secret must match apps/discovery's
# own DISCOVERY_SERVICE_SHARED_SECRET below and be at least 32 characters.
DISCOVERY_SERVICE_URL=
DISCOVERY_SERVICE_SHARED_SECRET=

# apps/discovery only — not run by `npm run dev`; start it explicitly with
# `npm run dev:discovery` to exercise the extracted path locally. Reuses
# SPOTIFY_CLIENT_ID/SECRET above and APP_URL for its MusicBrainz User-Agent;
# DISCOVERY_SERVICE_SHARED_SECRET must match the value set for apps/web above.
DISCOVERY_SERVICE_PORT=4001

# Development infrastructure
POSTGRES_USER=vinylhound
POSTGRES_PASSWORD=vinylhound
POSTGRES_DB=vinylhound
MINIO_ROOT_USER=vinylhound
MINIO_ROOT_PASSWORD=change-me-for-any-shared-environment
