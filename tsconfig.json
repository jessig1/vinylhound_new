{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["DOM", "DOM.Iterable", "ES2023"],
    "allowJs": false,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    // Relative imports inside packages name the TypeScript file they actually
    // resolve to (`./foo.ts`). Bundlers resolve that literally, which is what
    // lets `apps/web` consume package source under Turbopack — Turbopack has
    // no equivalent of webpack's `resolve.extensionAlias`, so the old
    // `./foo.js` specifiers could not be resolved there at all (ADR-0020).
    // `rewriteRelativeImportExtensions` rewrites them back to `./foo.js` on
    // emit, so the worker's compiled Node ESM output stays valid.
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true,
    "paths": {
      "@/*": ["./apps/web/src/*"]
    },
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "types": ["node"],
    "forceConsistentCasingInFileNames": true
  },
  "include": [
    "apps/**/*.ts",
    "apps/**/*.tsx",
    "packages/**/*.ts",
    "eslint.config.mjs",
    "prettier.config.mjs",
    "vitest.config.ts"
  ],
  "exclude": ["**/node_modules", "**/.next", "**/.next-e2e", "**/dist"]
}
