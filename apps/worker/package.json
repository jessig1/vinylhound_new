{
  "name": "@vinylhound/worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=../../.env src/index.ts",
    "build": "tsc --project tsconfig.json",
    "start": "node --env-file-if-exists=../../.env dist/index.js",
    "ops:drain-check": "tsx --env-file=../../.env src/ops.ts drain-check",
    "ops:reconcile-queue": "tsx --env-file=../../.env src/ops.ts reconcile-queue",
    "test:integration": "node --env-file-if-exists=../../.env ../../node_modules/vitest/vitest.mjs run --config vitest.integration.config.ts"
  },
  "dependencies": {
    "@aws-sdk/client-cloudwatch": "^3.1117.0",
    "@vinylhound/ai": "0.1.0",
    "@vinylhound/config": "0.1.0",
    "@vinylhound/contracts": "0.1.0",
    "@vinylhound/database": "0.1.0",
    "@vinylhound/domain": "0.1.0",
    "@vinylhound/queue": "0.1.0",
    "@vinylhound/storage": "0.1.0"
  },
  "devDependencies": {
    "drizzle-orm": "^0.45.2"
  }
}
