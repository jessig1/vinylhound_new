# syntax=docker/dockerfile:1.7
ARG NODE_IMAGE=node:22-bookworm-slim@sha256:83f487e0a63425e5b4d146fb5e5be574bcbe1b7b843d3ebafdd95eaf7767a7e5

FROM ${NODE_IMAGE} AS build
WORKDIR /workspace

COPY package.json package-lock.json ./
COPY apps/web/package.json apps/web/package.json
COPY apps/worker/package.json apps/worker/package.json
COPY packages/ai/package.json packages/ai/package.json
COPY packages/catalog/package.json packages/catalog/package.json
COPY packages/config/package.json packages/config/package.json
COPY packages/contracts/package.json packages/contracts/package.json
COPY packages/database/package.json packages/database/package.json
COPY packages/domain/package.json packages/domain/package.json
COPY packages/evals/package.json packages/evals/package.json
COPY packages/queue/package.json packages/queue/package.json
COPY packages/storage/package.json packages/storage/package.json
RUN --mount=type=cache,target=/root/.npm npm ci

COPY . .
# Workspace packages export TypeScript source for local tooling. Emit their
# JavaScript siblings so the compiled worker's `.js` specifiers resolve in the
# production image without shipping a TypeScript loader.
RUN npm run build --workspace @vinylhound/worker \
  && node node_modules/typescript/bin/tsc --project tsconfig.worker-runtime.json \
  && npm prune --omit=dev

FROM ${NODE_IMAGE} AS runtime
WORKDIR /workspace
ENV NODE_ENV=production \
    WORKER_HEALTH_FILE=/tmp/vinylhound-worker-health

# The pinned base image predates Debian's libpcre2-8-0 security backport
# (10.42-1+deb12u1, already in bookworm-security); pull it in explicitly
# instead of waiting on a new base image digest.
RUN apt-get update \
    && apt-get upgrade -y libpcre2-8-0 \
    && rm -rf /var/lib/apt/lists/*

# The runtime needs Node, not npm/corepack. Removing package-manager tooling
# eliminates its transitive vulnerability surface from the shipped image.
RUN rm -rf /usr/local/lib/node_modules/npm \
    /usr/local/lib/node_modules/corepack \
    /usr/local/bin/npm \
    /usr/local/bin/npx \
    /usr/local/bin/corepack

COPY --from=build --chown=node:node /workspace/package.json ./package.json
COPY --from=build --chown=node:node /workspace/node_modules ./node_modules
COPY --from=build --chown=node:node /workspace/packages ./packages
COPY --from=build --chown=node:node /workspace/apps/worker/package.json ./apps/worker/package.json
COPY --from=build --chown=node:node /workspace/apps/worker/dist ./apps/worker/dist

USER 1000:1000
STOPSIGNAL SIGTERM
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD ["node", "-e", "const{mtimeMs}=require('node:fs').statSync(process.env.WORKER_HEALTH_FILE);if(Date.now()-mtimeMs>120000)process.exit(1)"]


# --experimental-transform-types: apps/worker/dist's compiled output imports
# workspace packages (@vinylhound/ai, @vinylhound/queue, ...) by their bare
# specifier, which Node's own module resolution follows through each
# package's `"exports": "./src/index.ts"` straight to TypeScript source —
# the "emit JavaScript siblings" step above never intercepts this, since
# Node resolves the exports map literally rather than preferring a co-located
# .js file. Node 22's native TypeScript support loads plain, "erasable" TS
# without a flag, but several of those packages' error classes use
# constructor parameter properties (e.g. `packages/ai/src/
# album-identifier.ts`'s `ProviderError`), which is non-erasable and throws
# `ERR_UNSUPPORTED_TYPESCRIPT_SYNTAX` in the default strip-only mode —
# reproduced directly against this image's own pinned Node version while
# building apps/discovery for P4.1 Task 5, which hits the identical
# cross-package .ts resolution path. This flag switches Node to full
# transform mode so that syntax loads correctly instead.
CMD ["node", "--experimental-transform-types", "apps/worker/dist/index.js"]
